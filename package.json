{
  "name": "junit-results-toolkit",
  "version": "3.0.0",
  "description": "GitHub action for parsing JUnit results and generating reports",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto --kill-others-on-fail --timings",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint --fix .",
    "lint:format": "prettier --check .",
    "lint:format:fix": "prettier --write ."
  },
  "author": "Michael Stringer",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.7.0",
    "date-fns": "^4.1.0",
    "ejs": "^6.0.1",
    "junitxml-to-javascript": "^1.1.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/ejs": "^3.1.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@vercel/ncc": "^0.38.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.2.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
